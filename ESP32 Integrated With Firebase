#include <WiFi.h>
#include <WiFiClient.h>

const char* ssid = "Wokwi-GUEST";     // Ganti dengan SSID WiFi yang ingin dihubungkan
const char* password = ""; // Ganti dengan kata sandi WiFi yang sesuai
const int ledPin = 15; // Pin LED
#define MQ2_PIN 34 //Pin Sensor Gas

//==========================================================================================
//===============================Konfigurasi Firebase=======================================
//==========================================================================================
#include <HTTPClient.h>
#include <FirebaseESP32.h>
#define FIREBASE_HOST "akuisisi-data-test-default-rtdb.asia-southeast1.firebasedatabase.app" //dari realtime database > data > copy link, hapus https://
#define FIREBASE_AUTH "xxxxxxxxxxxxxxx" //dari Setting > Service Accounts > Database Secret > Copy Secret
FirebaseData firebaseData;
FirebaseAuth auth;
FirebaseConfig config;
//==========================================================================================
//==========================================================================================

void setup() {
  Serial.begin(115200);
  // Inisialisasi mode WiFi
  WiFi.mode(WIFI_STA);

  // Memulai scan WiFi
  Serial.println("Memulai scan WiFi...");
  int networksFound = WiFi.scanNetworks();

  // Menampilkan daftar jaringan WiFi yang terdeteksi
  if (networksFound == 0) {
    Serial.println("Tidak ada jaringan WiFi terdeteksi.");
  } else {
    Serial.print(networksFound);
    Serial.println(" jaringan WiFi terdeteksi:");

    for (int i = 0; i < networksFound; ++i) {
      Serial.print(i + 1);
      Serial.print(": ");
      Serial.print(WiFi.SSID(i));
      Serial.print(" (Signal: ");
      Serial.print(WiFi.RSSI(i));
      Serial.println(" dBm)");
    }

    // Menghubungkan ke WiFi yang terpilih
    connectToWiFi(ssid, password);
  }

//==========================================================================================
//===============================Konfigurasi Firebase=======================================
//==========================================================================================
  Serial.println("Menghubungkan ke Firebase...");
  config.host = FIREBASE_HOST;
  config.signer.tokens.legacy_token = FIREBASE_AUTH;
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);
  Serial.println("[BERHASIL] Firebase Siap Menerima Data!");
  Serial.println("================================");
//==========================================================================================
//==========================================================================================

}

void loop() {
  int nilaiGas = map(analogRead(MQ2_PIN), 843, 4041, 0, 1000);
  String kondisiSekitar = "";
  Serial.print("Nilai Sensor Gas : ");
  Serial.println(nilaiGas);
  
  if(nilaiGas >= 500){
    kondisiSekitar = "Sangat Berbahaya!!! Asap karhutla dapat memicu pusing dan sesak napas akut, tetap di dalam rumah! Jika perlu keluar gunakan Masker.";
    Serial.println(kondisiSekitar);
  }
  else{
    kondisiSekitar = "Kondisi masih aman";
    Serial.println(kondisiSekitar);
  }

//==========================================================================================
//==============================Kirim Data ke Firebase======================================
//==========================================================================================
  Firebase.setFloat(firebaseData, "/gas_sensor/value", nilaiGas);
  Firebase.setString(firebaseData, "/gas_sensor/condition", kondisiSekitar);
//==========================================================================================
//==========================================================================================
//Simpan data historis (riwayat) menggunakan pushJSON
  FirebaseJson jsonHistory;
  jsonHistory.set("value", nilaiGas);
  jsonHistory.set("condition", kondisiSekitar);
  jsonHistory.set("timestamp/.sv", "timestamp");
  if (Firebase.pushJSON(firebaseData, "/historyDataGas", jsonHistory)) {
    Serial.print("[HISTORY TERSIMPAN] ID Node: ");
    Serial.println(firebaseData.pushName());
  } else {
    Serial.print("[GAGAL SIMPAN HISTORY] Alasan: ");
    Serial.println(firebaseData.errorReason());
  }
//==========================================================================================
//==========================================================================================

  delay(1000);
}

void connectToWiFi(const char* ssid, const char* password) {
  Serial.println("Mencoba menghubungkan ke WiFi...");
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Gagal terhubung ke WiFi. Mencoba lagi...");
  }

  Serial.println("Terhubung ke WiFi!");
  Serial.print("Alamat IP: ");
  Serial.println(WiFi.localIP());
}
